{
  "name": "pato",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@12.23.0",
  "type": "module",
  "scripts": {
    "check": "pnpm format:check && pnpm lint && pnpm types && pnpm test && pnpm deadcode && pnpm dupes && pnpm trace",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "types": "tsc --noEmit",
    "test": "vitest run --coverage",
    "deadcode": "knip",
    "dupes": "jscpd",
    "trace": "node tools/trace/cli.ts",
    "next": "node tools/trace/cli.ts --next",
    "gates": "node tools/gates/cli.ts"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^10.15.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "jscpd": "^5.4.3",
    "knip": "^6.47.0",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
